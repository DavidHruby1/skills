#!/usr/bin/env bash

set -euo pipefail

REPOSITORY_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
OPENCODE_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/opencode"

SOURCE_DIR="$OPENCODE_DIR"
TARGET_DIR="$REPOSITORY_DIR"

if [[ "${1:-}" == "--to-opencode" ]]; then
    SOURCE_DIR="$REPOSITORY_DIR"
    TARGET_DIR="$OPENCODE_DIR"
elif [[ $# -gt 0 ]]; then
    printf 'Unknown argument: %s\n' "$1" >&2
    exit 1
fi

DIRECTORIES=(
    "skills"
    "agents"
    "commands"
    "docs"
    "plugins"
)

FILES=(
    "AGENTS.md"
    "agents-template.md"
    "bun.lock"
    "opencode-mem.jsonc"
    "opencode.jsonc"
    "package-lock.json"
    "package.json"
    "tui.json"
)

for path in "${DIRECTORIES[@]}" "${FILES[@]}"; do
    if [[ ! -e "$SOURCE_DIR/$path" ]]; then
        printf 'Missing source path: %s\n' "$SOURCE_DIR/$path" >&2
        exit 1
    fi
done

mkdir -p "$TARGET_DIR"

for directory in "${DIRECTORIES[@]}"; do
    rm -rf "$TARGET_DIR/$directory"
    cp -r "$SOURCE_DIR/$directory" "$TARGET_DIR/"
done

for file in "${FILES[@]}"; do
    cp "$SOURCE_DIR/$file" "$TARGET_DIR/"
done
