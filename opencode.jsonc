{
    "$schema": "https://opencode.ai/config.json",
    "autoupdate": false,
    "lsp": true,
    "compaction": {
        "model": "openai/gpt-5.6-luna",
        "variant": "high",
        "auto": true,
        "prune": true,
        "reserved": 200000
    },
    "references": {
        "isman-backend": "~/projects/isman/isman-backend",
        "isman-frontend": "~/projects/isman/isman-frontend-v3-update",
        "isman-worker": "~/projects/isman/worker-light",
        "mansel-backend": "~/projects/mansel/backend-v3",
        "mansel-frontend": "~/projects/mansel/frontend-v3",
        "mansel-worker": "~/projects/mansel/worker"
    },
    "mcp": {
        "duckduckgo": {
            "type": "local",
            "command": ["uvx", "duckduckgo-mcp-server"],
            "enabled": true,
        },
        "oracle": {
            "type": "local",
            "command": ["oracle-mcp"],
            "enabled": true,
            "environment": {
                "ORACLE_ENGINE": "browser",
                "ORACLE_HOME_DIR": "/home/hruby/.oracle",
                "ORACLE_BROWSER_PROFILE_DIR": "/home/hruby/.oracle/browser-profile",
                "ORACLE_BROWSER_REMOTE_DEBUG_HOST": "127.0.0.1",
                "ORACLE_CHROME_NO_SANDBOX": "1",
            },
        },
    },
    "permission": {
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "task": "allow",
        "todowrite": "allow",
        "question": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "skill": "allow",
        "lsp": "allow",
        "mcp": "allow",
        "read": {
            "*": "allow",
            "**/.env": "ask",
            "**/.env.*": "ask",
            "**/*.env": "ask",
            "**/*.env.*": "ask",
        },
        "edit": {
            "*": "allow",
            "**/.env": "ask",
            "**/.env.*": "ask",
            "**/*.env": "ask",
            "**/*.env.*": "ask",
        },
        "external_directory": {
            "*": "allow",
        },
        "bash": {
            "*": "allow",
            "rm *": "ask",
            "mv *": "ask",
            "cp *": "ask",
            "chmod *": "ask",
            "chown *": "ask",
            "sudo *": "ask",
            "git reset *": "ask",
            "git clean *": "ask",
            "git checkout *": "ask",
            "git restore *": "ask",
            "docker-compose *": "ask",
            "kubectl *": "ask",
            "helm *": "ask",
            "npm publish*": "ask",
            "pnpm publish*": "ask",
            "yarn publish*": "ask",
            "bun publish*": "ask",
            "wget *": "ask",
            "ssh *": "ask",
            "scp *": "ask",
            "rsync *": "ask",
        },
    },
    "provider": {
        "openai": {
            "models": {
                "gpt-5.6": {
                    "variants": {
                        "max": {
                            "reasoningEffort": "max",
                        },
                    },
                },
                "gpt-5.6-sol": {
                    "variants": {
                        "max": {
                            "reasoningEffort": "max",
                        },
                    },
                },
                "gpt-5.6-terra": {
                    "variants": {
                        "max": {
                            "reasoningEffort": "max",
                        },
                    },
                },
                "gpt-5.6-luna": {
                    "variants": {
                        "max": {
                            "reasoningEffort": "max",
                        },
                    },
                },
            },
        },
    },
    "agent": {
        "plan": {
            "model": "openai/gpt-5.6-luna",
            "variant": "xhigh",
            "color": "#5d8df5"
        },
        "build": {
            "model": "openai/gpt-5.6-luna",
            "variant": "high",
            "color": "#f0981d"
        },
        "explore": {
            "model": "opencode/deepseek-v4-flash-free",
            "variant": "high"
        },
        "general": {
            "model": "openai/gpt-5.6-luna",
            "variant": "xhigh",
            "permission": {
                "task": {
                    "*": "deny",
                    "explore": "allow"
                }
            }
        },
        "docu-writer": {
            "model": "openai/gpt-5.6-luna",
            "variant": "high"
        },
        "internal-researcher": {
            "model": "openai/gpt-5.6-luna",
            "variant": "high"
        },
        "external-researcher": {
            "model": "openai/gpt-5.6-luna",
            "variant": "high"
        },
        "code-mapper": {
            "model": "openai/gpt-5.6-luna",
            "variant": "high"
        },
        "brief-auditor": {
            "model": "openai/gpt-5.6-sol",
            "variant": "medium"
        },
        "plan-auditor": {
            "model": "openai/gpt-5.6-sol",
            "variant": "medium"
        },
        "ticket-master": {
            "model": "openai/gpt-5.6-luna",
            "variant": "medium"
        },
        "worker": {
            "model": "openai/gpt-5.6-luna",
            "variant": "max"
        },
        "tester": {
            "model": "openai/gpt-5.6-luna",
            "variant": "xhigh"
        },
        "inspector": {
            "model": "openai/gpt-5.6-sol",
            "variant": "high"
        },
        "bash-agent": {
            "model": "openai/gpt-5.6-luna",
            "variant": "medium"
        }
    },
    "plugin": ["./plugins/graphify.js", "./plugins/codex-identity.js"],
}
