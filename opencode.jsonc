{
    "$schema": "https://opencode.ai/config.json",
    "autoupdate": false,
    "lsp": true,
    "compaction": {
        "auto": true,
        "prune": true,
        "reserved": 100000
    },
    "mcp": {
        "duckduckgo": {
            "type": "local",
            "command": ["uvx", "duckduckgo-mcp-server"],
            "enabled": true
        }
    },
    "permission": {
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "task": "allow",
        "todowrite": "allow",
        "question": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "skill": "allow",
        "lsp": "allow",
        "mcp": "allow",
        "read": {
            "*": "allow",
            "**/.env": "ask",
            "**/.env.*": "ask",
            "**/*.env": "ask",
            "**/*.env.*": "ask"
        },
        "edit": {
            "*": "allow",
            "**/.env": "ask",
            "**/.env.*": "ask",
            "**/*.env": "ask",
            "**/*.env.*": "ask"
        },
        "external_directory": {
            "*": "allow"
        },
        "bash": {
            "*": "allow",
            "rm *": "ask",
            "mv *": "ask",
            "cp *": "ask",
            "chmod *": "ask",
            "chown *": "ask",
            "sudo *": "ask",
            "git reset *": "ask",
            "git clean *": "ask",
            "git checkout *": "ask",
            "git restore *": "ask",
            "docker-compose *": "ask",
            "kubectl *": "ask",
            "helm *": "ask",
            "npm publish*": "ask",
            "pnpm publish*": "ask",
            "yarn publish*": "ask",
            "bun publish*": "ask",
            "wget *": "ask",
            "ssh *": "ask",
            "scp *": "ask",
            "rsync *": "ask"
        }
    },
    "provider": {
        "openai": {
            "models": {
                "gpt-5.6-sol": {
                    "variants": {
                        "max": {
                            "reasoningEffort": "max"
                        }
                    }
                },
                "gpt-5.6-terra": {
                    "variants": {
                        "max": {
                            "reasoningEffort": "max"
                        }
                    }
                },
                "gpt-5.6-luna": {
                    "variants": {
                        "max": {
                            "reasoningEffort": "max"
                        }
                    }
                }
            }
        }
    },
    "agent": {
        "plan": {
            "model": "openai/gpt-5.6-sol",
            "variant": "medium",
            "color": "#5d8df5"
        },
        "build": {
            "model": "openai/gpt-5.6-sol",
            "variant": "low",
            "color": "#f0981d"
        },
        "explore": {
            "model": "openai/gpt-5.6-luna",
            "variant": "high"
        },
        "general": {
            "model": "openai/gpt-5.6-sol",
            "variant": "medium",
            "permission": {
                "task": {
                    "*": "deny",
                    "explore": "allow"
                }
            }
        },
        "docu-writer": {
            "model": "openai/gpt-5.6-luna",
            "variant": "high"
        },
        "researcher": {
            "model": "openai/gpt-5.6-luna",
            "variant": "high"
        },
        "worker": {
            "model": "openai/gpt-5.6-terra",
            "variant": "high"
        },
        "ticket-master": {
            "model": "openai/gpt-5.6-luna",
            "variant": "high"
        },
        "plan-auditor": {
            "model": "openai/gpt-5.6-terra",
            "variant": "high"
        },
        "inspector": {
            "model": "openai/gpt-5.6-sol",
            "variant": "medium"
        },
        "bash-agent": {
            "model": "openai/gpt-5.6-luna",
            "variant": "medium"
        }
    },
    "plugin": [
        "./plugins/codex-identity.js",
        "./plugins/large-read-guard.js",
        "./plugins/observability.js",
        "opencode-mem@2.26.0",
        [
            "opencode-session-recall@2.3.0",
            {
                "global": true,
                "nudge": true,
                "autoRecall": true,
                "compactionRecall": true
            }
        ]
    ]
}
