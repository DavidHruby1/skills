{
    "$schema": "https://opencode.ai/config.json",
    "autoupdate": false,
    "lsp": true,
    "references": {
        "isman-frontend": "~/projects/isman/isman-frontend-v3-update/",
        "isman-backend": "~/projects/isman/isman-backend/",
        "isman-worker": "~/projects/isman/worker-light/",
        "mansel-frontend": "~/projects/mansel/frontend-v3/",
        "mansel-backend": "~/projects/mansel/backend-v3/",
        "mansel-vck": "~/projects/mansel/mansel-vck1-vue3/",
    },
    "compaction": {
        "auto": true,
        "prune": true,
        "reserved": 100000
    },
    "mcp": {
        "duckduckgo": {
            "type": "local",
            "command": ["uvx", "duckduckgo-mcp-server"],
            "enabled": true
        }
    },
    "permission": {
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "task": "allow",
        "todowrite": "allow",
        "question": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "skill": "allow",
        "lsp": "allow",
        "mcp": "allow",
        "recall*": "deny",
        "read": {
            "*": "allow",
            "**/.env": "ask",
            "**/.env.*": "ask",
            "**/*.env": "ask",
            "**/*.env.*": "ask"
        },
        "edit": {
            "*": "allow",
            "**/.env": "ask",
            "**/.env.*": "ask",
            "**/*.env": "ask",
            "**/*.env.*": "ask"
        },
        "external_directory": {
            "*": "allow"
        },
        "bash": {
            "*": "allow",
            "rm *": "ask",
            "mv *": "ask",
            "cp *": "ask",
            "chmod *": "ask",
            "chown *": "ask",
            "sudo *": "ask",
            "git reset *": "ask",
            "git clean *": "ask",
            "git checkout *": "ask",
            "git restore *": "ask",
            "docker-compose *": "ask",
            "kubectl *": "ask",
            "helm *": "ask",
            "npm publish*": "ask",
            "pnpm publish*": "ask",
            "yarn publish*": "ask",
            "bun publish*": "ask",
            "wget *": "ask",
            "ssh *": "ask",
            "scp *": "ask",
            "rsync *": "ask"
        }
    },
    "provider": {
        "openai": {
            "models": {
                "gpt-5.6-sol": {
                    "variants": {
                        "max": {
                            "reasoningEffort": "max"
                        }
                    }
                },
                "gpt-5.6-terra": {
                    "variants": {
                        "max": {
                            "reasoningEffort": "max"
                        }
                    }
                },
                "gpt-5.6-luna": {
                    "variants": {
                        "max": {
                            "reasoningEffort": "max"
                        }
                    }
                }
            }
        },
        "ollama": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "Ollama (local)",
            "options": {
                "baseURL": "http://172.20.208.1:11434/v1"
            },
            "models": {
                "qwen3.6:35b-a3b-q4_K_M": {
                    "name": "Qwen 3.6 35B A3B Q4_K_M"
                }
            }
        }
    },
    "agent": {
        "plan": {
            "model": "openai/gpt-5.6-sol",
            "variant": "medium",
            "color": "#5d8df5"
        },
        "build": {
            "model": "openai/gpt-5.6-sol",
            "variant": "low",
            "color": "#f0981d"
        },
        "explore": {
            "description": "Read-only discovery for substantial investigations across interacting code areas. Never delegate to another agent. Outside commands, use direct tools for small lookups; unknown ownership alone does not justify delegation.",
            "model": "openai/gpt-5.6-luna",
            "variant": "high",
            "permission": {
                "task": "deny"
            }
        },
        "general": {
            "model": "openai/gpt-5.6-sol",
            "variant": "medium",
            "permission": {
                "task": {
                    "*": "deny",
                    "explore": "allow"
                }
            }
        },
        "docu-writer": {
            "model": "openai/gpt-5.6-luna",
            "variant": "high"
        },
        "researcher": {
            "model": "openai/gpt-5.6-luna",
            "variant": "high"
        },
        "worker": {
            "model": "openai/gpt-5.6-terra",
            "variant": "high"
        },
        "ticket-master": {
            "model": "openai/gpt-5.6-luna",
            "variant": "high"
        },
        "plan-auditor": {
            "model": "openai/gpt-5.6-terra",
            "variant": "high"
        },
        "inspector": {
            "model": "openai/gpt-5.6-sol",
            "variant": "medium"
        },
        "bash-agent": {
            "model": "openai/gpt-5.6-luna",
            "variant": "medium"
        }
    },
    "plugin": [
        "./plugins/codex-identity.js",
        "./plugins/observability.js",
        "opencode-mem@2.26.0",
        [
            "opencode-session-recall@2.3.0",
            {
                "global": true,
                "nudge": false,
                "autoRecall": false,
                "compactionRecall": false
            }
        ]
    ]
}
